{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-version-bump-hook.mjs",
            "if": "Bash(git commit*)",
            "statusMessage": "Checking package.json version bump..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/session-start-hint.mjs",
            "statusMessage": "Loading AGENTS.md hard constraints..."
          }
        ]
      }
    ]
  }
}
